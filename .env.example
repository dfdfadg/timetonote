# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for production.
# None of these are required for the site to build.

# Canonical origin (no trailing slash). Defaults to https://timetonote.com
NEXT_PUBLIC_SITE_URL=

# Public contact address shown on /contact and in Organization schema.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: X/Twitter handle including @ (used for twitter:site)
NEXT_PUBLIC_TWITTER_HANDLE=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics load only when set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: search engine verification tokens (content value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
